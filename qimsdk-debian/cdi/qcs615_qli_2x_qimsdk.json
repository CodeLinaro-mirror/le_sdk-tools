          {
            "path": "/dev/dri/renderD128",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/kgsl-3d0",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/dma_heap/system",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/fastrpc-cdsp",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/fastrpc-cdsp-secure",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          }
        ],
        "mounts": [
          {
            "hostPath": "/run/wayland-0",
            "containerPath": "/run/wayland-0",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/run/pulse/native",
            "containerPath": "/run/pulse/native",
            "options": [
