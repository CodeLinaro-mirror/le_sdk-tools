          },
          {
            "hostPath": "/usr/share/qcom/qcs615/Qualcomm/QCS615-RIDE/dsp/cdsp/fastrpc_shell_unsigned_3",
            "containerPath": "/usr/lib/dsp/cdsp/fastrpc_shell_unsigned_3",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/sys/firmware/devicetree/base/model",
            "containerPath": "/run/device-model",
            "options": [
              "rbind",
              "ro"
            ]
          }
