          "GST_PLUGIN_SCANNER=\"/usr/lib/aarch64-linux-gnu/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner\"",
          "XDG_RUNTIME_DIR=/run/user/1000",
          "WAYLAND_DISPLAY=/run/wayland-0",
          "VK_DRIVER_FILES=/usr/share/vulkan/icd.d/adrenovk.json",
          "OCL_ICD_FILENAMES=/usr/lib/aarch64-linux-gnu/libOpenCL_adreno.so.1",
          "__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_adreno.json",
          "DISPLAY_SOCKET=/run/wayland-0",
          "AUDIO_SOCKET=/run/pulse/native"
