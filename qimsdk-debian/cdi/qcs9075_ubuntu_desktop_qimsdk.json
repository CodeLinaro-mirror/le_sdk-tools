{
  "cdiVersion": "1.0.0",
  "kind": "qualcomm.com/device",
  "devices": [
    {
      "name": "qimsdk",
      "containerEdits": {
        "env": [
          "GST_DEBUG_NO_COLOR=1",
          "GST_DEBUG=2",
          "GST_PLUGIN_SCANNER=\"/usr/lib/aarch64-linux-gnu/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner\"",
          "XDG_RUNTIME_DIR=/run/user/1000",
          "VK_DRIVER_FILES=/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json",
          "OCL_ICD_FILENAMES=/usr/lib/aarch64-linux-gnu/libOpenCL_adreno.so.1",
          "__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json"
