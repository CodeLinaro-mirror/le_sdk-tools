        "deviceNodes": [
          {
            "path": "/dev/video0",
            "uid": 0,
            "gid": 44
          },
          {
            "path": "/dev/video1",
            "uid": 0,
            "gid": 44
          },
          {
            "path": "/dev/video32",
            "uid": 0,
            "gid": 44
          },
          {
            "path": "/dev/video33",
            "uid": 0,
            "gid": 44
          },
          {
            "path": "/dev/dri/card0",
            "uid": 0,
            "gid": 44
          },
          {
            "path": "/dev/dri/renderD128",
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/dma_heap/qcom,system",
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/dma_heap/system",
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/fastrpc-cdsp",
            "fileMode": 0660,
            "uid": 0,
            "gid": 44
          },
          {
            "path": "/dev/fastrpc-cdsp1",
            "fileMode": 0660,
            "uid": 0,
            "gid": 44
          }
        ],
        "mounts": [
          {
            "hostPath": "/etc/media",
            "containerPath": "/etc/media",
            "options": ["rbind", "rw"]
          },
          {
            "hostPath": "/etc/models",
            "containerPath": "/etc/models",
            "options": ["rbind", "rw"]
          },
          {
            "hostPath": "/etc/labels",
            "containerPath": "/etc/labels",
            "options": ["rbind", "rw"]
          },
          {
             "hostPath": "/etc/configs",
             "containerPath": "/etc/configs",
             "options": ["rbind", "rw"]
          },
          {
            "hostPath": "/run/cam_server",
            "containerPath": "/run/cam_server",
            "options": ["rbind", "rw"]
          },
          {
            "hostPath": "/run/user/1000",
            "containerPath": "/run/user/1000",
            "options": ["rbind", "rw"]
          },
          {
            "hostPath": "/sys/firmware/devicetree/base/model",
            "containerPath": "/run/device-model",
            "options": ["rbind"]
          }
        ]
