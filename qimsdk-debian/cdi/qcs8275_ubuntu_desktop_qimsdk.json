{
  "cdiVersion": "1.0.0",
  "kind": "qualcomm.com/device",
  "devices": [
    {
      "name": "qimsdk",
      "containerEdits": {
        "env": [
          "GST_DEBUG_NO_COLOR=1",
          "GST_DEBUG=2",
          "GST_PLUGIN_SCANNER=\"/usr/lib/aarch64-linux-gnu/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner\"",
          "XDG_RUNTIME_DIR=/run/user/1000",
          "WAYLAND_DISPLAY=wayland-1",
          "VK_DRIVER_FILES=/usr/share/vulkan/icd.d/freedreno_icd.json",
          "OCL_ICD_FILENAMES=/usr/lib/aarch64-linux-gnu/libOpenCL_adreno.so.1",
          "__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json",
          "DISPLAY_SOCKET=wayland-1",
          "AUDIO_SOCKET=/run/user/1000/pulse/native"
        ],
        "deviceNodes": [
          {
            "path": "/dev/video32",
            "fileMode": 0660,
            "uid": 0,
            "gid": 44
          },
          {
            "path": "/dev/video33",
            "fileMode": 0660,
            "uid": 0,
            "gid": 44
          },
          {
            "path": "/dev/dri/card0",
            "fileMode": 0660,
            "uid": 0,
            "gid": 44
          },
          {
            "path": "/dev/dri/renderD128",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/dma_heap/qcom,system",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/dma_heap/system",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/fastrpc-cdsp",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/fastrpc-cdsp-secure",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          }
        ],
        "mounts": [
          {
            "hostPath": "/home/ubuntu/media",
            "containerPath": "/home/qimsdk/media",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/home/ubuntu/models",
            "containerPath": "/home/qimsdk/models",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/home/ubuntu/labels",
            "containerPath": "/home/qimsdk/labels",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/home/ubuntu/configs",
            "containerPath": "/home/qimsdk/configs",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/etc/media",
            "containerPath": "/etc/media",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/etc/models",
            "containerPath": "/etc/models",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/etc/labels",
            "containerPath": "/etc/labels",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/etc/configs",
            "containerPath": "/etc/configs",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/run/user/1000",
            "containerPath": "/run/user/1000",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/usr/lib/dsp/cdsp",
            "containerPath": "/usr/lib/dsp/cdsp",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/sys/firmware/devicetree/base/model",
            "containerPath": "/run/device-model",
            "options": [
              "rbind",
              "rw"
            ]
          }
        ]
      }
    }
  ]
}
