            "gid": 1000
          },
          {
            "path": "/dev/dma_heap/qcom,system",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/dma_heap/system",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/fastrpc-cdsp",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/fastrpc-cdsp-secure",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/fastrpc-cdsp1",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/fastrpc-cdsp1-secure",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          }
        ],
        "mounts": [
          {
            "hostPath": "/home/ubuntu/media",
            "containerPath": "/home/qairt/media",
            "options": [
