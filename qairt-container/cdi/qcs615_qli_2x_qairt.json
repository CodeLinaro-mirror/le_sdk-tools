{
  "cdiVersion": "1.1.0",
  "kind": "qualcomm.com/device",
  "devices": [
    {
      "name": "qairt",
      "containerEdits": {
        "env": [
          "VK_DRIVER_FILES=/usr/share/vulkan/icd.d/adrenovk.json",
          "OCL_ICD_FILENAMES=/usr/lib/aarch64-linux-gnu/libOpenCL_adreno.so.1",
          "__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_adreno.json"
        ],
        "deviceNodes": [
          {
            "path": "/dev/kgsl-3d0",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/dma_heap/system",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/fastrpc-cdsp",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          },
          {
            "path": "/dev/fastrpc-cdsp-secure",
            "fileMode": 0660,
            "uid": 0,
            "gid": 1000
          }
        ],
        "mounts": [
          {
            "hostPath": "/usr/share/qcom/qcs615/Qualcomm/QCS615-RIDE/dsp",
            "containerPath": "/usr/lib/dsp",
            "options": [
              "rbind",
              "rw"
            ]
          },
          {
            "hostPath": "/sys/firmware/devicetree/base/model",
            "containerPath": "/run/device-model",
            "options": [
              "rbind",
              "rw"
            ]
          }
        ]
      }
    }
  ]
}
