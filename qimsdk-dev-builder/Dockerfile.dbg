# QIMSDK debug development Image
FROM debian:trixie-slim AS qimsdk_dbg_image

# Set base directory
ENV QIMSDK_BASE_DIR=/mnt/work
ENV QIMSDK_REPO_DOWNLOAD_DIR=${QIMSDK_BASE_DIR}/download/repo
ENV QIMSDK_TMP_DIR=${QIMSDK_BASE_DIR}/tmp
ENV QIMSDK_DOCKER_IMAGE_PATH=${QIMSDK_BASE_DIR}/dev_artifacts
RUN mkdir -p ${QIMSDK_DOCKER_IMAGE_PATH}
RUN mkdir -p ${QIMSDK_TMP_DIR}

# qimsdk: Add
COPY tmp/qimsdk ${QIMSDK_REPO_DOWNLOAD_DIR}/qimsdk

RUN echo "[url \"file://${QIMSDK_REPO_DOWNLOAD_DIR}/qimsdk\"] insteadOf =                          \
        https://github.com/qualcomm/qimsdk.git"                                                    \
        >> /etc/gitconfig

# Change workdir back to base dir from downloads dir
WORKDIR ${QIMSDK_BASE_DIR}
